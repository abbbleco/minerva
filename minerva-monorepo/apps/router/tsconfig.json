{
  "compilerOptions": {
    "target": "ES2022",
    // DOM fetch globals (fetch/Response/ReadableStream/TextDecoder): the service
    // calls upstream over fetch, so these are load-bearing. Declared here rather
    // than inherited from @types/node's undici wiring, which resolved
    // differently between installs and produced CI-only "Property does not
    // exist on type Response" failures. Interface merging + skipLibCheck keep
    // this conflict-free with Node's own globals.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  
  "include": ["api/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
