# ── Minerva Welcome API ──
# Free-tier inference entrypoint. A policy gate in front of the Minerva router,
# not a second inference engine: guest credentials in, free models only, relayed
# with the caller's own key so metering lands on their agency.

# Upstream router this service relays to.
MINERVA_ROUTER_URL=https://minrouter.abbbleco.workers.dev

# Free-model allowlist, comma-separated wire ids. Same variable and format the
# billing package uses; unset means the built-in default (cheapest stable free).
# MINERVA_FREE_MODELS=minerva/qwen-qwen3.8-27b:free

# Supabase (same project as portal + router). Service role: key verification
# reads agency_api_keys/agencies, which anon cannot.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call (comma-separated). Native clients ignore CORS.
# MINERVA_CORS_ORIGINS=https://portal.abbble.co.za

# PORT=8091
