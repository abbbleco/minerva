# ── Minerva monorepo ─────────────────────────────────────────────────
# pnpm workspace · Turborepo · Next.js 16 · Supabase

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# builds & caches
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# environment & secrets  (never commit)
.env
.env.*
!.env.example
*.pem
*.key
!*.pub

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# frameworks & deploy platforms
.vercel/
.netlify/

# supabase local dev
supabase/.branches/
supabase/.temp/
supabase/.env

# databases (local dev dumps)
*.sqlite
*.sqlite3
*.db
*.sql.gz
dump/

# operating systems
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~

# AI tooling (local state only)
.kilocode/
.cursor/
.claude/
.windsurf/
.history/

# NOTE: .opencode/ is tracked intentionally — project skills live in
# .opencode/skills/ and must be committed. Its node_modules is covered
# by the global node_modules/ rule above.

# misc junk
*.bak
*.orig
*.tmp
